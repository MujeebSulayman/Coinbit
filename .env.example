# ---------- Database ----------
DATABASE_URL="postgresql://coinbit:coinbit@localhost:5432/coinbit"

# ---------- Solana / Helius ----------
# Get a key at https://helius.dev (free tier works for alerts + paper mode)
HELIUS_API_KEY=""
# Optional overrides (default to Helius mainnet using the key above)
SOLANA_RPC_URL=""
SOLANA_WSS_URL=""
# Backup RPCs (comma-separated). The bot switches to the next one after repeated failures,
# and live trades are broadcast to all of them.
SOLANA_RPC_FALLBACK_URLS=""
# Cap on RPC requests per second across the whole bot (trades bypass it). Match your plan.
RPC_MAX_RPS="10"
# Optional PumpPortal key (https://pumpportal.fun, fund it with ≥0.02 SOL). Enables instant,
# pre-parsed trade events for watched wallets. Without it, PumpPortal is still used for free
# instant launch detection, and wallet trades come from the RPC websocket.
PUMPPORTAL_API_KEY=""

# ---------- Trading ----------
# Copy-trading mode: paper = simulate trades only (default, safe). live = sign and send real swaps.
# Each strategy's mode can also be switched Off / Paper / Live from the dashboard (Overview → Strategies);
# the dashboard setting overrides these defaults.
TRADING_MODE="paper"
# Base58 private key of a DEDICATED hot wallet. Only needed for live mode. Never your main wallet.
TRADER_PRIVATE_KEY=""
POSITION_SIZE_SOL="0.1"
MAX_OPEN_POSITIONS="5"
DAILY_LOSS_LIMIT_SOL="0.5"
SLIPPAGE_BPS="1500"
PRIORITY_FEE_LAMPORTS="200000"
# Live swaps are also sent to Jito as a bundle with this tip (only paid if Jito lands it). 0 = off.
JITO_TIP_LAMPORTS="100000"
# Jito block engine base URL (default mainnet). Use a regional one near your server for speed.
JITO_URL=""

# ---------- Signal rules ----------
MIN_CONFLUENCE="2"            # tracked wallets that must buy the same coin
CONFLUENCE_WINDOW_MIN="10"    # ...within this many minutes
MAX_ENTRY_MCAP_USD="150000"   # skip coins already bigger than this
MAX_TOKEN_AGE_MIN="120"       # skip coins older than this
MAX_TOP10_HOLDER_PCT="45"     # skip if top 10 holders (ex-curve) own more than this
LAUNCHER_SOLO_SIGNAL="true"   # a high-score launcher creating a coin can trigger alone
MAX_DEV_HOLD_PCT="10"         # skip if the creator still holds more than this % of supply
MAX_LAUNCH_SNIPE_PCT="15"     # skip if others bought more than this % in the launch slot (bundles)
MAX_CURVE_PROGRESS_PCT="95"   # skip coins about to graduate off the bonding curve
MAX_PRICE_IMPACT_PCT="5"      # skip if our buy would move the price more than this

# ---------- Exits ----------
TAKE_PROFIT_LEVELS="100:50,300:30,900:20"  # +gain% : % of position to sell
STOP_LOSS_PCT="35"
MAX_HOLD_MIN="240"
MIRROR_EXITS="true"           # sell when the wallets that triggered the entry sell

# ---------- Discovery ----------
DISCOVERY_INTERVAL_MIN="360"  # how often the bot hunts for new smart wallets
WATCHLIST_SIZE="150"
EARLY_BUYER_COUNT="60"        # how many first buyers per winning coin to study
MIN_WINNERS_FOR_WATCH="2"     # wallet must be early on at least this many winners
WINNER_MIN_MCAP_USD="250000"  # a coin counts as a "winner" above this market cap

# ---------- Wallet vetting (full trade history) ----------
# Before a wallet is watched, its recent trades across ALL coins are checked, not just winners.
HIST_TX_SAMPLE="120"          # recent transactions sampled per wallet
HIST_WALLETS_PER_RUN="30"     # wallets vetted per pass
VET_INTERVAL_MIN="5"          # how often background vetting runs
HIST_MIN_TOKENS="8"           # need at least this many coins in the sample to judge
HIST_MIN_WIN_RATE="0.35"      # exclude below this win rate
HIST_MIN_PNL_SOL="0"          # exclude if net PnL (incl. coins still held) is below this
HIST_MAX_TOKENS_PER_HOUR="10" # faster than this = bot
HIST_RECHECK_DAYS="3"
DISCOVERY_MAX_TOKENS="40"     # winners studied per discovery run

# ---------- Alerts / dashboard ----------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Protects dashboard actions (run discovery, pause trading)
ADMIN_TOKEN="change-me"

# ---------- Migration strategy (pump.fun graduations to PumpSwap) ----------
MIGRATION_MODE="paper"            # off | paper | live (dashboard can override)
MIGRATION_SIZE_SOL="0.05"         # per trade
MIGRATION_MAX_OPEN="3"
MIGRATION_DELAY_SEC="420"         # decide 7 min after migration: past pump.fun's 5-min BOOST buybacks
MIGRATION_BOOST_SEC="300"         # length of the BOOST buyback window (ignored when judging demand)
MIGRATION_MIN_POOL_SOL="30"       # real SOL in the PumpSwap pool at decision time
MIGRATION_MAX_DROP_PCT="10"       # skip if price is more than this % below the graduation price
MIGRATION_MAX_PUMP_PCT="100"      # skip if it is already this % above the graduation price
MIGRATION_MIN_BUY_RATIO="1.2"     # buys ÷ sells after the BOOST window
MIGRATION_MIN_TRADERS="15"        # distinct traders after the BOOST window
MIGRATION_MIN_SMART_WALLETS="0"   # require this many watched wallets holding it
MIGRATION_MIN_FILL_MIN="10"       # skip coins that went launch → graduation faster than this (bundled/manufactured)
MIGRATION_MIN_LIQUIDITY_USD="13000" # both sides of the pool, in USD
MIGRATION_SKIP_LONG_RUN="true"    # skip coins with 1000+ curve trades before graduating
MIGRATION_MAX_QUOTE_DRIFT_PCT="5" # re-quote just before buying; skip if the price moved more than this during the checks
MIGRATION_TAKE_PROFIT_LEVELS="30:50,100:25,200:25"
MIGRATION_STOP_LOSS_PCT="25"
MIGRATION_MAX_HOLD_MIN="60"

# ---------- Launch sniper (buys new pump.fun coins moments after creation) ----------
LAUNCH_MODE="off"                 # off | paper | live (dashboard can override). Paper-test first.
LAUNCH_SIZE_SOL="0.05"
LAUNCH_MAX_OPEN="3"
LAUNCH_MAX_PER_HOUR="20"          # buys per rolling hour
LAUNCH_MIN_DEV_BUY_SOL="0"        # creator's own buy in the create tx
LAUNCH_MAX_DEV_BUY_SOL="5"
LAUNCH_MAX_CREATOR_LAUNCHES_7D="3" # skip serial launchers
LAUNCH_REQUIRE_PROVEN_DEV="false" # only creators who graduated a coin before
LAUNCH_SLIPPAGE_PCT="25"
LAUNCH_PRIORITY_FEE_SOL="0.0005"
# "Drafter" entry: watch each new coin and buy only into real demand (free: Helius account subscriptions)
LAUNCH_WATCH_SEC="60"             # stop watching a coin if demand hasn't shown by then
LAUNCH_MAX_WATCHING="40"
LAUNCH_FLOW_BLOCKS="10"           # demand window (1 block ≈ 0.4s)
LAUNCH_MIN_INFLOW_SOL="5"         # net SOL bought within the window
LAUNCH_MIN_BUY_BLOCKS="4"         # blocks with net buying within the window
LAUNCH_MAX_CURVE_SOL="85"         # curve's virtual SOL at entry (starts 30, completes ~115)
LAUNCH_REQUIRE_DEV_SOLD="false"
LAUNCH_PAPER_DELAY_MS="1200"      # paper fills at the curve this long after the trigger (≈ live landing)
# Exit: block-timed sell ladder from the buy, "block:sell%"
LAUNCH_SELL_LADDER="1:20,5:15,10:15,15:15,20:15,25:20"
LAUNCH_EXIT_ON_DEV_SELL="true"
LAUNCH_STOP_LOSS_PCT="20"
LAUNCH_MAX_HOLD_MIN="1"

# ---------- Exits for every strategy ----------
PROFIT_LOCK_ARM_PCT="10"          # once up this much, a stop follows the peak... 0 = off
PROFIT_LOCK_KEEP_PCT="55"         # ...keeping this share of the peak gain
QUOTE_SHOCK_PCT="20"              # sell at once on a drop this big from the recent high (confirmed by a fresh quote). 0 = off
QUOTE_SHOCK_WINDOW_SEC="10"
STAGNANT_MIN="10"                 # sell a position that has gone nowhere for this long. 0 = off
STAGNANT_BAND_PCT="10"

# ---------- Exits after the first take-profit (all strategies) ----------
BREAKEVEN_AFTER_TP="true"        # after TP1, sell the rest if it falls back to entry + buffer
BREAKEVEN_BUFFER_PCT="2"
TRAIL_AFTER_TP_PCT="30"          # ...or if it falls this % below its peak (whichever is higher). 0 = off
STOP_CONFIRM_TICKS="2"           # consecutive price readings below a stop before selling (ignores single wicks)

# ---------- Extra safety checks (both strategies) ----------
MAX_ROUNDTRIP_LOSS_PCT="10"      # sellability: quote buy→sell first; skip honeypots / coins that lose more than this
MAX_DEV_SOLD_PCT="50"            # skip if the creator already sold more than this % of their launch buy
MIN_WINNERS_WITH_HISTORY="1"     # wallets early on just 1 winner can be watched if their full history proves them

# ---------- Early-warning exits (both strategies) ----------
INSIDER_EXIT="true"              # sell everything if the coin's top-5 holders sell off together (or one big holder dumps)
INSIDER_MIN_HOLD_PCT="1"         # watch the top-5 wallets holding at least this % of supply (single trigger: 3× this)
INSIDER_SELL_PCT="50"            # trigger when together they've sold this share of their combined holdings
MOMENTUM_EXIT="true"             # after TP1: sell the rest when sellers clearly take over
MOMENTUM_WINDOW_SEC="90"
MOMENTUM_SELL_RATIO="2"          # SOL sold ≥ this × SOL bought in the window
MOMENTUM_MIN_TRADES="5"
