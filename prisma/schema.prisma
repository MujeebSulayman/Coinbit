generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A wallet the discovery engine has studied. kind = TRADER (early buyer) or LAUNCHER (coin creator).
model Wallet {
  address        String    @id
  kind           String    @default("TRADER")
  status         String    @default("CANDIDATE") // CANDIDATE | WATCHING | EXCLUDED
  excludeReason  String?
  allowed        Boolean   @default(false) // manually allowed from the dashboard: automatic filters skip it
  score          Float     @default(0)
  winners        Int       @default(0) // winning coins it entered early
  tokensSeen     Int       @default(0)
  avgEntryRank   Float     @default(0) // 1 = first buyer
  avgEntryMin    Float     @default(0) // minutes after launch
  launches       Int       @default(0)
  launchWinners  Int       @default(0)
  botChecked     Boolean   @default(false) // passed the high-frequency-bot check
  signalHits     Int       @default(0) // signals this wallet contributed to
  copyPnlSol     Float     @default(0) // PnL of our copies it triggered
  firstSeen      DateTime  @default(now())
  lastScored     DateTime  @default(now())
  lastActivity   DateTime?
  // Full-history vetting (all recent trades, not just winners)
  histTokens       Int?
  histWinRate      Float?
  histPnlSol       Float?
  histTokensPerHour Float?
  histCheckedAt    DateTime?
  entries        EarlyEntry[]

  @@index([status, score])
}

model Token {
  mint         String    @id
  symbol       String?
  name         String?
  creator      String?
  launchedAt   DateTime?
  createSlot   Int?
  peakMcapUsd  Float     @default(0)
  mcapUsd      Float     @default(0)
  isWinner     Boolean   @default(false)
  studiedAt    DateTime?
  createdAt    DateTime  @default(now())
  entries      EarlyEntry[]

  @@index([creator])
}

/// Every pump.fun launch (from the PumpPortal feed), kept ~10 days: who launched what, and when.
/// Feeds the dev-reputation check (has this creator been launching other coins lately?).
model Launch {
  mint    String   @id
  creator String
  at      DateTime @default(now())

  @@index([creator, at])
  @@index([at])
}

model EarlyEntry {
  id         Int      @id @default(autoincrement())
  wallet     String
  mint       String
  rank       Int
  minutesIn  Float
  solAmount  Float
  slot       Int
  w          Wallet   @relation(fields: [wallet], references: [address], onDelete: Cascade)
  t          Token    @relation(fields: [mint], references: [mint], onDelete: Cascade)

  @@unique([wallet, mint])
}

/// Live buys/sells by watched wallets, seen by the listener.
model WalletEvent {
  id          Int      @id @default(autoincrement())
  wallet      String
  mint        String
  side        String   // BUY | SELL | CREATE
  tokenDelta  Float
  solDelta    Float
  signature   String
  ts          DateTime @default(now())

  @@unique([signature, wallet, mint])
  @@index([mint, ts])
}

model Signal {
  id          Int      @id @default(autoincrement())
  strategy    String   @default("copy") // copy | migration
  mint        String
  symbol      String?
  reason      String
  wallets     String[]
  confluence  Int
  mcapUsd     Float?
  ageMin      Float?
  top10Pct    Float?
  devHoldPct  Float?
  snipePct    Float?   // % of supply bought by others in the launch slot
  curvePct    Float?   // bonding curve progress
  impactPct   Float?   // estimated price impact of our buy
  devGrads    Int?     // other coins by this creator that graduated (since we started recording)
  devRecent   Int?     // other coins this creator launched in the last 7 days
  socials     Int?     // how many of X / Telegram / website the coin lists (0-3)
  // Shadow tracking: what this coin did after the decision, taken or skipped (filled in by the worker)
  priceSol    Float?   // price at decision time
  peakRet     Float?   // best return (%) seen within 60 minutes
  ret15       Float?   // return (%) after 15 minutes
  ret60       Float?   // return (%) after 60 minutes
  decision    String   // TAKEN | SKIPPED
  skipReason  String?
  positionId  Int?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model Position {
  id              Int       @id @default(autoincrement())
  strategy        String    @default("copy") // copy | migration
  pool            String?   // PumpSwap pool, once the coin has migrated
  mint            String
  symbol          String?
  mode            String    // PAPER | LIVE
  status          String    @default("OPEN") // OPEN | CLOSED
  sizeSol         Float
  entryPriceSol   Float
  tokenAmount     Float
  remainingTokens Float
  realizedSol     Float     @default(0)
  currentPriceSol Float
  peakPriceSol    Float
  tpHit           Int       @default(0)
  triggerWallets  String[]
  entrySig        String?
  exitSigs        String[]
  exitReason      String?
  openedAt        DateTime  @default(now())
  closedAt        DateTime?

  @@index([status])
}

model Kv {
  key   String @id
  value String
}

model RunLog {
  id        Int      @id @default(autoincrement())
  kind      String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Every buy and (partial) sell of a position, for the trade detail page.
model Fill {
  id         Int      @id @default(autoincrement())
  positionId Int
  side       String   // BUY | SELL
  tokens     Float
  sol        Float
  priceSol   Float
  reason     String?
  signature  String?
  ts         DateTime @default(now())

  @@index([positionId, ts])
}

/// Price samples while a position is open (throttled), for the trade detail chart.
model PricePoint {
  id         Int      @id @default(autoincrement())
  positionId Int
  priceSol   Float
  ts         DateTime @default(now())

  @@index([positionId, ts])
}
